# Copy this file to .env and fill in the values. Never commit .env.
PORT=3001
# The web app address, for CORS.
WEB_ORIGIN=http://localhost:5173

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Your Claude API key from the Anthropic Console (platform.claude.com). Secret, server only.
ANTHROPIC_API_KEY=
# Optional: the Claude model for extraction (default: claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5
